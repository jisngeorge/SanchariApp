<resources>
    <style name="Theme.SanchariApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_variant</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/action_green</item>
        <item name="colorSecondaryVariant">@color/action_green_variant</item>
        <item name="colorOnSecondary">@color/action_on_green</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/home_background</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
        <item name="appBarLayoutStyle">@style/Widget.Sanchari.AppBarLayout</item>
        <item name="toolbarStyle">@style/Widget.Sanchari.Toolbar</item>
        <item name="actionBarStyle">@style/Widget.Sanchari.ActionBar</item>
    </style>

    <style name="Theme.SanchariApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>