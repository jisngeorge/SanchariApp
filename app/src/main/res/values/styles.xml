<resources>
    <style name="Widget.Sanchari.HomeIcon" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="tint">?attr/colorControlNormal</item>
    </style>

    <style name="Widget.Sanchari.Button.HomeCompact" parent="Widget.Sanchari.Button.HomeSecondary">
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">4dp</item>
    </style>
    <style name="Widget.Sanchari.AppBarLayout" parent="Widget.Design.AppBarLayout">
        <item name="android:background">@color/brand_header</item>
    </style>

    <style name="Widget.Sanchari.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/brand_header</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <style name="Widget.Sanchari.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/brand_header</item>
    </style>

    <style name="Widget.Sanchari.Button.PrimaryAction" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary_action_background</item>
        <item name="android:textColor">@color/primary_action_text</item>
        <item name="iconTint">@color/primary_action_text</item>
    </style>

    <style name="Widget.Sanchari.HomeCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/home_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Sanchari.Button.HomeSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="TextAppearance.Sanchari.HomeHeading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsCard" parent="Widget.Sanchari.HomeCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBody1</item>
    </style>
</resources>
