<resources>
    <style name="Widget.Sanchari.AppBarLayout" parent="Widget.Design.AppBarLayout">
        <item name="android:background">@color/brand_header</item>
    </style>

    <style name="Widget.Sanchari.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/brand_header</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <style name="Widget.Sanchari.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/brand_header</item>
    </style>

    <style name="Widget.Sanchari.Button.PrimaryAction" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary_action_background</item>
        <item name="android:textColor">@color/primary_action_text</item>
        <item name="iconTint">@color/primary_action_text</item>
    </style>

    <style name="Widget.Sanchari.HomeCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/home_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Sanchari.Button.HomeSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="TextAppearance.Sanchari.HomeHeading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
